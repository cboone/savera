#!/usr/bin/env bash
# build-audio-unit — configure and build Savera's clap-wrapper projection
set -euo pipefail
function main() {
	[[ ${#} -le 1 ]] || {
		echo "usage: build-audio-unit [--reconfigure]" >&2
		return 64
	}
	case "${1:-}" in "" | --reconfigure) ;; *)
		echo "usage: build-audio-unit [--reconfigure]" >&2
		return 64
		;;
	esac
	# Reconfigure to refresh environment-supplied signing options and header checks.
	cmake -B build cmake || return 65
	cmake --build build --target savera_all || return 65
	[[ -d build/assets/Savera.clap && -d build/assets/Savera.component ]] || return 66
}
main "$@"
