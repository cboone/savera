#!/usr/bin/env bash
# assert-adhoc-signature — verify every named bundle has an ad-hoc signature
set -euo pipefail
function main() {
	[[ ${#} -gt 0 ]] || {
		echo "usage: assert-adhoc-signature <bundle>..." >&2
		return 64
	}
	local bundle
	for bundle in "$@"; do
		codesign --verify --deep --strict --verbose=2 "${bundle}"
		codesign -dvvv "${bundle}" 2>&1 | grep -q 'Signature=adhoc'
	done
}
main "$@"
