# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# zig fmt is the authority for both. This only keeps editors from fighting it.
[*.{zig,zon}]
indent_style = space
indent_size = 4

[*.{c,cpp,h}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{json,jsonc,toml,yml,yaml}]
indent_style = space
indent_size = 2

# markdownlint's MD009 already governs trailing whitespace here and allows the
# two spaces that mean a hard line break. Nothing relies on that today; this
# keeps the editor from stripping it before markdownlint can have an opinion.
[*.md]
trim_trailing_whitespace = false

# shfmt reads this profile natively. Formatting flags would override it.
[{scripts/*,cmake/narrow-au-resource-usage,cmake/set-au-display-name}]
indent_style = tab
binary_next_line = false
switch_case_indent = false
space_redirects = false

# A Python section arrives with Phase 2's harness. ruff ignores this file, so
# that section and ruff.toml will be two statements of one style, with
# ruff.toml the authority.
